# systemd-юнит Connor (см. environment.md § "Развёртывание").
#
# Установка:
#   sudo cp deploy/connor.service /etc/systemd/system/connor.service
#   sudo $EDITOR /etc/systemd/system/connor.service   # выправить User/пути под свой VPS
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now connor
#   journalctl -u connor -f          # смотреть лог (строки [startup] — стартовая диагностика)
#

[Unit]
Description=Connor — Discord moderation bot (single guild)
After=network-online.target
Wants=network-online.target

# Против busy-loop: не больше 5 неудачных стартов за 300 c, иначе systemd
# уводит юнит в failed и перестаёт дёргать (снять — `systemctl reset-failed connor`).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=connor
Group=connor
WorkingDirectory=/opt/connor
ExecStart=/opt/connor/.venv/bin/python -m connor

Restart=on-failure
RestartSec=10
# exit 2 = невалидный конфиг (.env / config/*.toml). Рестартить бессмысленно —
# сидим в failed, пока оператор не починит и не сделает `systemctl restart`.
# exit 1 (сбой входа / БД / фатальный preflight) — рестартим, но под StartLimit.
RestartPreventExitStatus=2

# Учёт памяти/CPU для этого юнита — не везде default (зависит от дистрибутива/
# образа VPS). Без него `systemctl status`/`systemd-cgtop` не покажут потребление
# юнита вообще (пусто, а не 0) — включаем явно, чтобы не зависеть от системных
# настроек по умолчанию.
MemoryAccounting=yes
CPUAccounting=yes

# Файловые логи по умолчанию в /opt/connor/logs (внутри ReadWritePaths — писать
# можно). Свой каталог — задать LOG_DIR в .env и добавить его сюда, напр.:
#   LogsDirectory=connor            # systemd создаст /var/log/connor
#   и LOG_DIR=/var/log/connor в .env
# Ротация/удаление старых срезов — внутри бота (посуточно, ~месяц), logrotate не нужен.

# Опциональное усиление (снять/подправить, если мешает):
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/connor

[Install]
WantedBy=multi-user.target
