# Connor — обязательная конфигурация окружения.
# Скопировать в `.env` и заполнить реальными значениями. `.env` в git не коммитится.
# Все *_ID / CH_* / CAT_* / ROLE_* — это Discord snowflake (целые числа).
# Подробности по каналам/ролям — py-discord-connor.wiki/Home.md, environment.md.

# --- база ---
GUILD_ID=
BOT_TOKEN=
DB_PATH=./connor.sqlite3

# --- роли, которыми бот управляет (выдаёт/снимает) ---
ROLE_RABOTYAGA=
ROLE_MOLCHUN=
ROLE_DUSHA=

# --- каналы ---
CH_REKVESTY=            # #реквесты-работяг — заявки на ручную проверку !give (@here + ✅/❌)
CH_BOT_KOMANDY=         # #бот-команды — mute/kick, лог !purge, 2-е уведомление о «Душе компании»
CH_ANTIRABOTYAGI=       # #антиработяги — /add /del и наблюдение за ручным изменением роли
CH_AUDIT=              # #аудит — решения модераторов по !give
CH_VYDACHA=            # #выдача-работяг — единственное место вызова !give
CH_BANY=              # #баны — /ban /unban
CH_FLUDISLAVL=          # #флудиславль — /check, /vkick, /vreturn, /ladder, уведомление о «Душе компании»
CH_CHEKLIST=           # #чек-лист — пересылка по подозрительным словам
CH_CHEKLIST2=          # #чек-лист2 — пересылка по медиа
CH_PREDLOZHKA=          # #предложка — платный канал, точечная блокировка анти-работяг
CH_TRIGGER_VOICE=       # статичный войс «создать свою комнату»

# --- категории ---
CAT_RODDOM=            # модераторская категория «роддом» (исключения moderationChat/purge/XP-тик)
CAT_PRIVATE_VOICE=      # категория, внутри которой бот создаёт приватные комнаты
